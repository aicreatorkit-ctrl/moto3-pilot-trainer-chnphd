
# Supabase Configuration
# Ottieni questi valori da: https://app.supabase.com/project/_/settings/api

EXPO_PUBLIC_SUPABASE_URL=your-project-url.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Note:
# 1. Copia questo file in .env
# 2. Sostituisci i valori con quelli del tuo progetto Supabase
# 3. Non committare il file .env nel repository
